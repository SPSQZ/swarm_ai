# RescuePilot Environment Configuration (Optional)
#
# NOTE: RescuePilot runs 100% offline out-of-the-box with ZERO keys required!
# (The built-in deterministic model engine handles all tool reasoning automatically).
#
# If you wish to connect to live Amazon Bedrock foundation models:
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1

# Optional Model ID override (default: amazon.nova-micro-v1:0 or anthropic.claude-3-haiku-20240307-v1:0)
RESCUE_PILOT_MODEL=amazon.nova-micro-v1:0
